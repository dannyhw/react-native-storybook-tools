{
  "name": "react-native-storybook-tools",
  "version": "0.0.1",
  "workspaces": [
    "rozenite-plugin",
    "example"
  ],
  "scripts": {
    "repo:fix": "sherif --fix -r unsync-similar-dependencies",
    "build": "bun --filter rozenite-storybook build",
    "dev": "bun --filter rozenite-storybook dev",
    "example:start": "bun --filter example start",
    "example:android": "bun --filter example android",
    "example:ios": "bun --filter example ios"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "sherif": "^1.8.0"
  },
  "private": true,
  "packageManager": "bun@1.3.5"
}
